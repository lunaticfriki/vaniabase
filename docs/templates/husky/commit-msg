#!/usr/bin/env sh
set -eu

MESSAGE_FILE="$1"
PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?: .+'
HEADER="$(head -n 1 "$MESSAGE_FILE")"

if ! echo "$HEADER" | grep -Eq "$PATTERN"; then
  echo "Commit message does not follow the conventional-commit format:" >&2
  echo "  type(scope): description" >&2
  echo "Got: $HEADER" >&2
  exit 1
fi
