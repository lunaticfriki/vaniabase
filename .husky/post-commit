# Recursion guard: this fires again when we amend below - do nothing that time.
if [ -n "$VANIA_AMEND_IN_PROGRESS" ]; then
  exit 0
fi

GIT_DIR="$(git rev-parse --git-dir)"
MSG_FILE="$GIT_DIR/VANIA_COMMIT_MSG"

if [ -f "$MSG_FILE" ]; then
  MSG="$(cat "$MSG_FILE")"
  rm -f "$MSG_FILE"
  VANIA_AMEND_IN_PROGRESS=1 git commit --amend -m "$MSG" >/dev/null
fi
