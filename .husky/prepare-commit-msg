GIT_DIR="$(git rev-parse --git-dir)"
MESSAGE_FILE="$1"
SOURCE="$2"

# A message was already supplied some other way (-m, -F, merge, squash,
# --amend/-C/-c reusing an existing message) - leave it untouched.
case "$SOURCE" in
  message|merge|squash|commit)
    exit 0
    ;;
esac

# Don't run the wizard for merges, rebases or cherry-picks in progress.
if [ -f "$GIT_DIR/MERGE_HEAD" ] || \
   [ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] || \
   [ -d "$GIT_DIR/rebase-merge" ] || \
   [ -d "$GIT_DIR/rebase-apply" ]; then
  exit 0
fi

# Reconnect stdin to the terminal so the wizard can prompt interactively.
# (Guarded: /dev/tty can exist but not actually be attachable, e.g. in CI
# or a detached process - in that case just leave stdin as-is and let the
# wizard's own non-TTY check skip the prompts.)
if (exec < /dev/tty) 2>/dev/null; then
  exec < /dev/tty
fi

node scripts/commit-wizard.mjs "$MESSAGE_FILE"
